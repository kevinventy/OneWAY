{
  "expo": {
    "name": "ONE WAY",
    "slug": "oneway",
    "version": "1.3.3",
    "orientation": "portrait",
    "scheme": "oneway",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "icon": "./assets/icon.png",
    "splash": {
      "image": "./assets/splash-icon.png",
      "backgroundColor": "#ffffff",
      "resizeMode": "contain"
    },
    "assetBundlePatterns": ["**/*"],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "mg.oneway.app"
    },
    "android": {
      "package": "mg.oneway.app",
      "versionCode": 25,
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#ffffff"
      },
      "permissions": [
        "ACCESS_FINE_LOCATION",
        "ACCESS_COARSE_LOCATION",
        "ACCESS_BACKGROUND_LOCATION",
        "FOREGROUND_SERVICE",
        "FOREGROUND_SERVICE_LOCATION",
        "CAMERA"
      ]
    },
    "web": {
      "bundler": "metro",
      "output": "single",
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-build-properties",
        { "android": { "kotlinVersion": "1.9.25" } }
      ],
      [
        "expo-location",
        {
          "locationAlwaysAndWhenInUsePermission": "ONE WAY utilise votre position pour le suivi des livraisons, y compris en arrière-plan pendant une course.",
          "locationWhenInUsePermission": "ONE WAY utilise votre position pour le suivi des livraisons.",
          "isAndroidBackgroundLocationEnabled": true,
          "isAndroidForegroundServiceEnabled": true
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "ONE WAY accède à vos photos pour les preuves de chargement/livraison.",
          "cameraPermission": "ONE WAY utilise la caméra pour la photo de preuve de livraison."
        }
      ],
      [
        "expo-notifications",
        { "color": "#2a44a0" }
      ]
    ],
    "extra": {
      "router": { "origin": false },
      "firebase": {
        "apiKey": "AIzaSyCWxVofx8do9JzZrs2b8ywx-ZKQy-cqclw",
        "authDomain": "oneway-77f85.firebaseapp.com",
        "projectId": "oneway-77f85",
        "storageBucket": "oneway-77f85.firebasestorage.app",
        "messagingSenderId": "365501423696",
        "appId": "1:365501423696:web:06ba6663b14ecae1b1f155"
      }
    }
  }
}
