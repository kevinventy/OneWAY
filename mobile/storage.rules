rules_version = '2';

// Règles Firebase Storage — ONE WAY.
// Photos de preuve de livraison (pod/…) et pièces jointes : lecture/écriture
// réservées aux utilisateurs authentifiés.
service firebase.storage {
  match /b/{bucket}/o {
    match /{allPaths=**} {
      allow read, write: if request.auth != null;
    }
  }
}
