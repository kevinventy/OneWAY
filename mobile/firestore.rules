rules_version = '2';

// Règles ONE WAY — transporteur unique (gérant + chauffeurs, client public).
// Cloisonnement : chaque utilisateur ne voit/agit que sur ses propres courses.
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() { return request.auth != null; }
    function uid() { return request.auth.uid; }

    // Profils : lecture par tout connecté (résolution du code entreprise + noms),
    // écriture uniquement par le propriétaire du compte.
    match /users/{id} {
      allow read: if signedIn();
      allow create, update: if signedIn() && uid() == id;
    }

    function myPhone() {
      return get(/databases/$(database)/documents/users/$(uid())).data.phone;
    }

    // Courses : gérant propriétaire ou chauffeur assigné (lecture + écriture),
    // et le client (lecture seule de SES courses, rattachées à son téléphone).
    match /courses/{id} {
      allow read: if signedIn() && (
        resource.data.ownerId == uid() ||
        resource.data.driverUserId == uid() ||
        resource.data.client.phone == myPhone()
      );
      allow create: if signedIn() && request.resource.data.ownerId == uid();
      allow update: if signedIn() && (resource.data.ownerId == uid() || resource.data.driverUserId == uid());
      allow delete: if false;
    }

    // Demandes de devis : créées par le client, consultées/traitées par le gérant.
    match /quoteRequests/{id} {
      allow read: if signedIn();
      allow create: if signedIn() && request.resource.data.clientId == uid();
      allow update: if signedIn();
    }

    // Chauffeurs : gérant propriétaire, ou le chauffeur sur sa propre fiche.
    match /drivers/{id} {
      allow read: if signedIn() && (resource.data.ownerId == uid() || resource.data.userId == uid());
      allow create: if signedIn() && request.resource.data.userId == uid();
      allow update: if signedIn() && (resource.data.ownerId == uid() || resource.data.userId == uid());
    }

    // Véhicules : lecture par le gérant propriétaire ; mise à jour de la
    // disponibilité par un participant connecté (chauffeur lors de la livraison).
    match /vehicles/{id} {
      allow read: if signedIn() && resource.data.ownerId == uid();
      allow create: if signedIn() && request.resource.data.ownerId == uid();
      allow update: if signedIn();
    }

    // Événements de suivi (interne).
    match /events/{id} {
      allow read, create: if signedIn();
    }

    // Notifications : lecture par le destinataire uniquement.
    match /notifications/{id} {
      allow read: if signedIn() && resource.data.userId == uid();
      allow create: if signedIn();
      allow update: if signedIn() && resource.data.userId == uid();
    }

    match /counters/{id} { allow read, write: if signedIn(); }

    // Suivi PUBLIC par code : lisible sans compte (données sanitisées), écrit
    // par l'app authentifiée. Aucune donnée sensible (ni prix, ni infos client).
    match /tracking/{code} {
      allow read: if true;
      allow write: if signedIn();
    }
  }
}
