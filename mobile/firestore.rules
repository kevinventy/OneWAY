rules_version = '2';

// Règles de sécurité ONE WAY (MVP). À durcir avant production (validation de
// schéma, vérification des montants côté Cloud Functions pour le séquestre).
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() { return request.auth != null; }
    function isOwner(uid) { return isSignedIn() && request.auth.uid == uid; }

    // Profils : lecture par tout utilisateur connecté (réputation), écriture par le propriétaire.
    match /users/{uid} {
      allow read: if isSignedIn();
      allow create: if isOwner(uid);
      allow update: if isOwner(uid)
        // l'utilisateur ne peut pas se promouvoir admin ni gonfler sa note
        || (isSignedIn() && request.resource.data.diff(resource.data).affectedKeys()
              .hasOnly(['rating', 'ratingCount']));
    }

    // Annonces de fret : lecture par tout connecté ; création/maj par le chargeur propriétaire.
    match /freights/{id} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && request.resource.data.shipperId == request.auth.uid;
      allow update: if isSignedIn(); // statut mis à jour lors de l'acceptation/avancement
    }

    // Offres : lecture par tout connecté ; un transporteur ne crée que ses propres offres.
    match /bids/{id} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && request.resource.data.carrierId == request.auth.uid;
      allow update: if isSignedIn();
    }

    // Expéditions, suivi, documents, transactions, avis, notifications : connecté.
    match /shipments/{id}   { allow read, write: if isSignedIn(); }
    match /tracking/{id}    { allow read, write: if isSignedIn(); }
    match /documents/{id}   { allow read, write: if isSignedIn(); }
    match /transactions/{id}{ allow read, write: if isSignedIn(); }
    match /reviews/{id}     { allow read: if isSignedIn();
                              allow create: if isSignedIn() && request.resource.data.fromUserId == request.auth.uid; }
    match /notifications/{id}{ allow read, write: if isSignedIn(); }
    match /vehicles/{id}    { allow read: if isSignedIn();
                              allow write: if isSignedIn() && request.resource.data.carrierId == request.auth.uid; }
    match /drivers/{id}     { allow read, write: if isSignedIn(); }
    match /counters/{id}    { allow read, write: if isSignedIn(); }
  }
}
