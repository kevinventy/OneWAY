# ─────────────────────────────────────────────────────────────
# ONE WAY — Variables d'environnement (exemple)
# Copiez ce fichier vers `.env` puis adaptez les valeurs.
# ─────────────────────────────────────────────────────────────

# Base de données
# Dev : SQLite (zéro configuration, fichier local).
# Prod : remplacez par une URL PostgreSQL (ex. Neon, Supabase, RDS)
#   DATABASE_URL="postgresql://user:pass@host:5432/oneway?schema=public"
DATABASE_URL="file:./dev.db"

# Secret de signature des sessions JWT (changez en production !)
AUTH_SECRET="dev-secret-change-me-in-production-please-32chars-min"

# ─── Intégrations (optionnelles en dev, requises en prod) ───

# Cartographie : Mapbox ou Google Maps (le MVP utilise une carte
# embarquée sans clé ; ces clés activent le rendu/itinéraires réels).
NEXT_PUBLIC_MAPBOX_TOKEN=""
GOOGLE_MAPS_API_KEY=""

# Paiements mobile money / carte
STRIPE_SECRET_KEY=""
WAVE_API_KEY=""
ORANGE_MONEY_CLIENT_ID=""
ORANGE_MONEY_CLIENT_SECRET=""
MTN_MOMO_SUBSCRIPTION_KEY=""

# Notifications
FCM_SERVER_KEY=""          # Push (Firebase Cloud Messaging)
TWILIO_ACCOUNT_SID=""      # SMS
TWILIO_AUTH_TOKEN=""
TWILIO_FROM_NUMBER=""

# Stockage des documents/photos (S3 compatible)
S3_ENDPOINT=""
S3_BUCKET="oneway-documents"
S3_ACCESS_KEY=""
S3_SECRET_KEY=""
